#!/bin/sh /etc/rc.common

# Openwalla Netify collector init service.
# Starts the Netify flow collector and restarts it if the stream exits.

START=95
STOP=10
USE_PROCD=1

PROG="/usr/bin/openwalla-netify-collector"

# procd tracks the parent shell; its stream worker is a child. Kill any
# leftovers from a previous stop/restart before starting a new instance.
kill_stale() {
	local pid
	for pid in $(ps w | awk '$0 ~ /\/usr\/bin\/[o]penwalla-netify-collector/ {print $1}'); do
		[ "$pid" = "$$" ] && continue
		kill "$pid" 2>/dev/null
	done
	sleep 1
}

start_service() {
	local enabled
	enabled="$(uci -q get openwalla.collector.enabled 2>/dev/null || echo 1)"
	[ "$enabled" = "0" ] && return 0

	kill_stale
	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "openwalla"
}
